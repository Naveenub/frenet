{
  "name": "frenet",
  "version": "0.1.0",
  "description": "FRENET \u2014 decentralized, privacy-first peer-to-peer internet (Phase 1 MVP node)",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "frenet": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-web.mjs",
    "start": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:natlab": "FRENET_NATLAB=1 node --import tsx --test test/natlab.test.ts"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@chainsafe/libp2p-quic": "^2.1.5",
    "@chainsafe/libp2p-yamux": "^8.0.1",
    "@libp2p/autonat-v2": "^2.1.8",
    "@libp2p/bootstrap": "^12.0.36",
    "@libp2p/circuit-relay-v2": "^4.2.17",
    "@libp2p/crypto": "^5.2.0",
    "@libp2p/dcutr": "^3.0.32",
    "@libp2p/identify": "^4.1.18",
    "@libp2p/kad-dht": "^16.4.9",
    "@libp2p/mdns": "^12.0.36",
    "@libp2p/peer-id": "^6.0.18",
    "@libp2p/ping": "^3.1.17",
    "@libp2p/tcp": "^11.0.32",
    "@libp2p/upnp-nat": "^4.0.32",
    "@multiformats/multiaddr": "^13.0.3",
    "@noble/curves": "^2.4.0",
    "libp2p": "^3.5.1",
    "multiformats": "^14.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0"
  }
}
